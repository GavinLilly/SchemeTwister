{
  "name": "web-app-feature-view",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/web-app/feature-view/src",
  "prefix": "schemetwister",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/libs/web-app/feature-view"
      ],
      "options": {
        "jestConfig": "libs/web-app/feature-view/jest.config.ts",
        "tsConfig": "libs/web-app/feature-view/tsconfig.spec.json"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ]
    }
  }
}
