{
  "name": "series-marvel-studios",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/series/marvel-studios/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ],
      "options": {
        "lintFilePatterns": [
          "libs/series/marvel-studios/**/*.{ts,tsx,js,jsx}",
          "libs/series/marvel-studios/package.json"
        ]
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "main": "libs/series/marvel-studios/src/index.ts",
        "outputPath": "dist/libs/series/marvel-studios",
        "outputFileName": "index.js",
        "tsConfig": "libs/series/marvel-studios/tsconfig.lib.json",
        "platform": "neutral",
        "format": [
          "esm",
          "cjs"
        ],
        "declaration": true,
        "assets": [
          "libs/series/marvel-studios/README.md"
        ],
        "esbuildOptions": {
          "mainFields": [
            "module",
            "main"
          ],
          "loader": {
            ".png": "dataurl"
          }
        }
      },
      "configurations": {
        "development": {
          "minify": false
        },
        "production": {
          "minify": true
        }
      }
    }
  }
}