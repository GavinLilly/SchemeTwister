{
  "name": "web-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-app/src",
  "prefix": "schemetwister",
  "tags": [],
  "generators": {
    "@nx/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "outputPath": "dist/apps/web-app",
        "index": "apps/web-app/src/index.html",
        "browser": "apps/web-app/src/main.ts",
        "polyfills": [
          "apps/web-app/src/polyfills.ts"
        ],
        "tsConfig": "apps/web-app/tsconfig.app.json",
        "aot": true,
        "assets": [
          "apps/web-app/src/favicon.ico",
          "apps/web-app/src/assets",
          "apps/web-app/src/manifest.webmanifest"
        ],
        "styles": [
          "apps/web-app/src/styles.scss"
        ],
        "loader": {
          ".png": "dataurl"
        },
        "scripts": [],
        "sourceMap": true,
        "optimization": false,
        "serviceWorker": "apps/web-app/ngsw-config.json"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/web-app/src/environments/environment.ts",
              "with": "apps/web-app/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false,
          "buildOptimizer": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        },
        "local": {
          "fileReplacements": [
            {
              "replace": "apps/web-app/src/environments/environment.ts",
              "with": "apps/web-app/src/environments/environment.local.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "continuous": true,
      "options": {
        "proxyConfig": "apps/web-app/proxy.conf.json",
        "buildTarget": "web-app:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "web-app:build:production"
        },
        "local": {
          "buildTarget": "web-app:build:local"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "web-app:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ]
    },
    "test": {
      "options": {
        "passWithNoTests": true,
        "coverage": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "deploy": {
      "executor": "@angular/fire:deploy",
      "options": {}
    }
  }
}