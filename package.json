  "scripts": {
    "ng": "nx",
    "postinstall": "pnpm run build-version",
    "postversion": "pnpm run build-version",
    "start": "nx serve",
    "startdev": "nx serve --configuration local",
    "build": "pnpm run build-version && nx build",
    "build-prod": "pnpm run build --prod",
    "test": "nx run-many --target=test --update-snapshot",
    "lint": "nx run-many --target=lint",
    "commit": "cz",
    "build-version": "genversion --es6 --semi libs/web-app/ui/src/lib/footer/version.ts",
    "deploy": "firebase deploy",
    "prepare": "husky",
    "test:ci": "pnpm run test && node ./tools/coverageMerger.js"
  },
