{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2023",
    "module": "esnext",
    "lib": ["dom", "ES2023"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@schemetwister/libtwister": ["libs/libtwister/src/index.ts"],
      "@schemetwister/libtwister/testing": [
        "libs/libtwister/src/testing.index.ts"
      ],
      "@schemetwister/schematics": [
        "tools/schemetwister-schematics/src/index.ts"
      ],
      "@schemetwister/series-buffy": ["dist/libs/series/buffy"],
      "@schemetwister/series-marvel": ["dist/libs/series/marvel"],
      "@schemetwister/series-marvel-common": ["dist/libs/series/marvel-common"],
      "@schemetwister/series-marvel-studios": [
        "dist/libs/series/marvel-studios"
      ],
      "@schemetwister/series-marvel-villains": [
        "dist/libs/series/marvel-villains"
      ],
      "@schemetwister/web-app-feature-view": [
        "libs/web-app/feature-view/src/index.ts"
      ],
      "@schemetwister/web-app/feature-home": [
        "libs/web-app/feature-home/src/index.ts"
      ],
      "@schemetwister/web-app/feature-randomize": [
        "libs/web-app/feature-randomize/src/index.ts"
      ],
      "@schemetwister/web-app/feature-setup-store": [
        "libs/web-app/feature-setup-store/src/index.ts"
      ],
      "@schemetwister/web-app/feature-store": [
        "libs/web-app/feature-store/src/index.ts"
      ],
      "@schemetwister/web-app/shared": ["libs/web-app/shared/src/index.ts"],
      "@schemetwister/web-app/ui": ["libs/web-app/ui/src/index.ts"]
    },
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp"],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
